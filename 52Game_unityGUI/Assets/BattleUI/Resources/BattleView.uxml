<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="BattleView.uss" />
    <ui:VisualElement name="battle-screen" class="battle-screen">
        <ui:VisualElement class="battle-shell">
            <ui:VisualElement class="battle-header">
                <ui:VisualElement class="title-group">
                    <ui:Label text="收益挑战" class="screen-title" />
                    <ui:VisualElement name="scenario-buttons" class="scenario-buttons" />
                </ui:VisualElement>
                <ui:VisualElement class="battle-summary">
                    <ui:Label name="round" class="round-value" />
                    <ui:Label name="benefit" class="benefit-value" />
                    <ui:Button name="restart" text="重开" class="battle-button restart-button" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="battle-content">
                <ui:VisualElement class="battle-board">
                    <ui:VisualElement class="battle-panel queue-panel">
                        <ui:VisualElement class="zone-heading">
                            <ui:Label text="待结算队列" class="section-title" />
                            <ui:Label text="从左到右结算" class="zone-meta" />
                        </ui:VisualElement>
                        <ui:VisualElement name="queue" class="queue-row" />
                    </ui:VisualElement>

                    <ui:VisualElement class="battle-panel hand-panel">
                        <ui:VisualElement class="zone-heading">
                            <ui:Label text="手牌" class="section-title" />
                            <ui:Label name="pile-counts" class="zone-meta" />
                        </ui:VisualElement>
                        <ui:ScrollView name="hand-scroll" class="hand-scroll" mode="Horizontal"
                                       horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden">
                            <ui:VisualElement name="hand" class="hand-row" />
                        </ui:ScrollView>
                    </ui:VisualElement>

                    <ui:VisualElement class="battle-actions">
                        <ui:Label name="feedback" class="feedback" />
                        <ui:Button name="finish-challenge" text="提前完成" class="battle-button finish-button" />
                        <ui:Button name="end-turn" text="结束回合" class="battle-button end-button" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="battle-panel settlement-panel">
                    <ui:Label name="settlement-heading" text="结算记录" class="section-title settlement-title" />
                    <ui:ScrollView class="settlement-scroll" horizontal-scroller-visibility="Hidden"
                                   vertical-scroller-visibility="Auto">
                        <ui:VisualElement name="settlement" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="drag-layer" class="drag-layer" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
